# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Embedding: sentence-transformers (local, default) | openai | wordllama
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DEVICE=cpu

# Only if EMBEDDING_PROVIDER=openai (OpenAI or OpenRouter)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
